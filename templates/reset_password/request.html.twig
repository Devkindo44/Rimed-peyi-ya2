{% extends 'base.html.twig' %}

{% block title %}Réinitialisation du mot de passe{% endblock %}

{% block h1 %}Mot de passe oublié{% endblock %}

{% block body %}
    {# Conteneur principal #}
    <div class="position-relative d-flex align-items-center justify-content-center shadow rounded-5" style="min-height: 100vh; overflow: hidden;">
        
        {# Image en arrière-plan absolu #}
        <img src="{{ asset('images/p-connexion.jpg') }}" 
             class="position-absolute top-0 start-0 w-100 h-100" 
             alt="Réinitialisation du mot de passe" 
             style="object-fit: cover; z-index: 1; filter: brightness(0.3);">

        {# Formulaire stylisé #}
        <div class="col-md-4 p-4 shadow rounded btn-custom-cream" style="z-index: 10; backdrop-filter: blur(5px);">
            
            {% for flash_error in app.flashes('reset_password_error') %}
                <div class="alert alert-danger text-center" role="alert">{{ flash_error }}</div>
            {% endfor %}

            <h1 class="h3 mb-3 font-weight-normal text-center text-white">Mot de passe oublié</h1>
            
            <p class="text-white-50 text-center small mb-4">
                Saisissez votre adresse e-mail. Nous vous enverrons un lien pour réinitialiser votre mot de passe.
            </p>

            {{ form_start(requestForm) }}
                {# Champ Email #}
                <div class="mb-3 text-start">
                    {{ form_label(requestForm.email, 'Email', {'label_attr': {'class': 'form-label text-white'}}) }}
                    {{ form_widget(requestForm.email, {
                        'attr': {
                            'class': 'form-control',
                            'placeholder': 'votre@email.com',
                            'autofocus': true
                        }
                    }) }}
                    {{ form_errors(requestForm.email) }}
                </div>

                {# Bouton d'envoi #}
                <button class="btn btn-lg btn-custom-green w-100 mt-3" type="submit">
                    Envoyer l'e-mail
                </button>
            {{ form_end(requestForm) }}

            {# Lien pour retourner à la connexion #}
            <div class="text-center mt-4">
                <a href="{{ path('app_login') }}" class="text-white text-decoration-underline small">
                    Retour à la page de connexion
                </a>
            </div>
        </div>
    </div>
{% endblock %}