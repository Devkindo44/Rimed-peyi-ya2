{% extends 'base.html.twig' %}

{% block title %}Mon historique de commandes{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">Mon historique de commandes</h1>

    {# CONDITION : Si le tableau des commandes est vide #}
    {% if commandes is empty %}
        <div class="alert alert-warning p-4 shadow-sm text-center">
            <h4 class="alert-heading">Aucune commande pour le moment !</h4>
            <p>Il semblerait que vous n'ayez pas encore validé de commande sur notre site.</p>
            <hr>
            <a href="{{ path('app_home_catalogue') }}" class="btn btn-primary">
               <span><i class="bi bi-journal-richtext"></i></span> Découvrir notre catalogue
            </a>
        </div>
    
    {# SINON : Si l'utilisateur a des commandes, on affiche le tableau #}
    {% else %}
        <div class="card shadow-sm">
            <div class="table-responsive ">
                <table class="table table-bordered table-hover align-vertical align-middle mb-0">
                    <thead class="table-dark border-white">
                        <tr>
                            <th class="text-white py-3" style="background-color: var(--main-green) !important;">N° Commande</th>
                            <th class="text-white py-3" style="background-color: var(--main-green) !important;">Date</th>
                            <th class="text-white py-3" style="background-color: var(--main-green) !important;">Transporteur</th>
                            <th class="text-white py-3" style="background-color: var(--main-green) !important;">Adresse de livraison</th>
                            <th class="text-white py-3" style="background-color: var(--main-green) !important;">Montant Total</th>
                            <th class="text-white py-3" style="background-color: var(--main-green) !important;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {# Correction de la syntaxe : 'for' à la place de 'foreach' #}
                        {% for commande in commandes %}
                            <tr>
                                <td><strong>#{{ commande.id }}</strong></td>
                                <td>{{ commande.date|date('d/m/Y H:i') }}</td>
                                <td>{{ commande.transporteurNom }}</td>
                                <td>
                                    {% if commande.adressedeLivraison %}
                                        {{ commande.adressedeLivraison.adressePostale }}, 
                                        {{ commande.adressedeLivraison.codePostale }} {{ commande.adressedeLivraison.ville }}
                                    {% else %}
                                        <span class="text-muted">Non spécifiée</span>
                                    {% endif %}
                                </td>
                                <td><strong>{{ commande.montantTotal|number_format(2, ',', ' ') }} €</strong></td>
                                <td>
                                    <a href="{{ path('app_commande_recap', {'id': commande.id}) }}" class="btn btn-sm btn-outline-primary">
                                        <span><i class="bi bi-search"></i></span> Voir le détail
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}