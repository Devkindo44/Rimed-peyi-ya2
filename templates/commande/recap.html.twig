{% extends 'base.html.twig' %}

{% block title %}Recap{% endblock %}

{% block body %}
<div class="container mt-4 px-2">
    <h2>Récapitulatif de votre commande</h2>


    {# --- BLOC ADRESSE DE LIVRAISON MIS À JOUR (SANS ERREUR) --- #}
    <div class="card my-4 border-success">
        <div class="card-header text-white" style="background-color: var(--main-green) !important;">
            <h5 class="mb-0"><i class="fas fa-map-marker-alt me-2"></i>Adresse de livraison</h5>
        </div>
        <div class="card-body bg-light text-dark">
            <p class="mb-1 fw-bold">{{ commande.utilisateur.firstName }} {{ commande.utilisateur.lastName }}</p>
            <p class="mb-1">{{ commande.adressedeLivraison.adressePostale }}</p>
            {# Affichage combiné "Code Postal + Ville" #}
            <p class="mb-1">{{ commande.adressedeLivraison.codePostale }} {{ commande.adressedeLivraison.ville|upper }}</p>
            
            {# --- RÉCUPÉRATION DU TÉLÉPHONE DEPUIS L'UTILISATEUR --- #}
            {% if commande.utilisateur.numeroDeTelephone %}
                <p class="mb-0 mt-2 text-muted small">
                  <span><i class="bi bi-telephone-fill"></i></span> {{ commande.utilisateur.numeroDeTelephone }}
                </p>
            {% endif %}
        </div>
    </div>
    {# ---------------------------------------- #}

    {# --- AJOUT DE LA DIV RESPONSIVE --- #}
    <div class="table-responsive mt-4 border border-success">
        <table class="table table-bordered mt-4 align-middle table align-middle mb-0 table-bordered table-hover text-center text-white bg-success">
            <thead class="border border-success">
                <tr>
                    
                    <th class="text-white py-3" style="background-color: var(--main-green) !important;">Image</th>
                    <th class="text-white py-3" style="background-color: var(--main-green) !important;">Produit</th>
                    <th class="text-white py-3" style="background-color: var(--main-green) !important;">Quantité</th>
                    {# "text-md-end" aligne à droite sur PC, mais reste centré sur mobile pour un meilleur visuel #}
                    <th class="text-white py-3" style="background-color: var(--main-green) !important;">Prix Unitaire</th>
                    <th class="text-white py-3" style="background-color: var(--main-green) !important;">Total</th>
                </tr>
            </thead>
            <tbody>
            {% for ligne in commande.ligneDeCommandes %}
                <tr>
                    {# 1. COLONNE IMAGE #}
                    <td>
                        {% if ligne.product.illustration %}
                            <img src="{{ asset('images/' ~ ligne.product.illustration) }}" 
                                 alt="{{ ligne.product.title }}" 
                                 style="width: 60px; height: 60px; object-fit: cover; border-radius: 5px;">
                        {% else %}
                            <img src="{{ asset('images/default-product.png') }}" 
                                 alt="Pas d'image" 
                                 style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;">
                        {% endif %}
                    </td>

                    {# 2. RESTE DES INFORMATIONS #}
                  
                    <td>{{ ligne.product.title }}</td> 
                    <td class="text-center">{{ ligne.quantity }}</td> 
                    <td class="text-center text-md-end">{{ ligne.prixUnitaire }} €</td>
                    <td class="text-center text-md-end">{{ (ligne.prixUnitaire * ligne.quantity) }} €</td>
                </tr>
            {% endfor %}
            
            {# --- DÉTAIL DES TOTAUX COMPLÈTS --- #}
            
            {# 1. SOUS-TOTAL (Produits uniquement) #}
            <tr class="table-light fw-semibold text-dark">
                <td colspan="4" class="text-end py-2">Sous-total articles :</td>
                <td class="text-end py-2">
                    {# Calcul dynamique : Total général - Frais de port #}
                    {{ (commande.montantTotal - commande.fraisPort)|number_format(2, ',', ' ') }} €
                </td>
            </tr>

            {# 2. FRAIS DE PORT & TRANSPORTEUR #}
            <tr class="table-light text-muted small text-dark">
                <td colspan="4" class="text-end py-2">
                    Livraison : <span class="fst-italic">({{ commande.transporteurNom }})</span>
                </td>
                <td class="text-end py-2">
                    {% if commande.fraisPort == 0 %}
                        <span class="text-success fw-bold">Gratuit</span>
                    {% else %}
                        {{ commande.fraisPort|number_format(2, ',', ' ') }} €
                    {% endif %}
                </td>
            </tr>
            
            {# 3. MONTANT TOTAL FINAL #}
            <tr class="table-light fw-bold text-dark" style="border-top: 2px solid var(--main-green);">
                <td colspan="4" class="text-end py-3 fs-5">Montant Total :</td>
                <td class="text-end py-3 text-custom-brown fs-5">
                    {{ commande.montantTotal|number_format(2, ',', ' ') }} €
                </td>
            </tr>

            </tbody>
        </table>
    </div>
    {# --- FIN DE LA DIV RESPONSIVE --- #}

</div>
{% endblock %}