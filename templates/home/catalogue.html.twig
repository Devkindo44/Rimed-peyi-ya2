{% extends 'base.html.twig' %}


{# bloc pour les metadonnées seo#}

{% block title %}{{parent()}} | Catalogue{% endblock %}
{% block description %}{{parent()}} |  Catalogue{% endblock %}
{% block keywords %}{{parent()}} |  Catalogue{% endblock %}
{% block h1 %}Catalogue{% endblock %}









{% block body %}
<div class="container-fluid my-5 px-4">
    
    {# class Bootstrap #}
    <div class="row row-cols-1 row-cols-sm-2 shadow rounded bg-custom-green row-cols-md-6 row-cols-lg-7 g-3 mb-5 ">
        
       {% for product in products %}
            {# Chaque carte est enveloppée dans une colonne de la grille #}
            <div class="col  1rem; transition: transform 0.3s ease;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                <div class="card h-100 shadow-sm" style="max-width: 18rem;">
                    
                    {# Titre de la carte #}
                    <div class="card-header bg-transparent border-0 pt-3 pb-0">
                        {# Remplacement de product.title par product.name suite à vos modifications #}
                        <h5 class="card-title fw-bold text-truncate mb-0">{{product.title}}</h5>
                    </div>

                    {# IMAGE illustration #}
                    <div class="p-2">
                        <img src="/images/{{ product.illustration }}"
                             class="card-img-top rounded img-fluid" 
                             style="height: 187px; object-fit: cover;" 
                             alt="{{ product.title }}">
                    </div>
                    
                    {# Corps de la carte pour le prix et la description #}
                    <div class="card-body d-flex flex-column pt-0">
                        
                        {# champs  Prix #}
                
                        <div class="text-success fw-bold fs-5 mb-2">
                            {{ product.price }} €
                        </div>
                        
                        {# champs  DESCRIPTION #}
                        {# (ex: product.description) #}
                        <p class="card-text text-muted small flex-grow-1">
                            {{ product.description }}
                        </p>
                        
                        {# BOUTON (voir le produit en bas de la carte) #}
                        <div class="mt-3">
                            <a href="#" class="btn btn-custom-brown w-100">Voir plus</a>
                        </div>
                    </div>

                </div>
            </div>

            {% endfor %}


