{% extends 'base.html.twig' %}

{# bloc pour les metadonnées seo #}
{% block title %}{{ parent() }} | Catalogue{% endblock %}
{% block description %}{{ parent() }} | Catalogue{% endblock %}
{% block keywords %}{{ parent() }} | Catalogue{% endblock %}
{% block h1 %}Catalogue{% endblock %}

{% block body %}
<div class="container my-5 px-4  ">
    {% if is_granted('ROLE_ADMIN') %}
    <a class="btn btn-custom-green" href="{{ path('app_admin_user_index')}}">Retour tableau de bord</a>
    {% endif %}
    {# BARRE DE FILTRES DES CATÉGORIES #}
    <div class="text-center mb-5">
        <h4 class="mb-3 text-muted ">Rechercher par catégorie :</h4>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a href="{{ path('app_home_catalogue') }}" class="btn btn-outline-success   rounded-pill">
                 Tout le catalogue
            </a>
            
            {% for categorie in categories %}
                <a href="{{ path('app_categories_show', {'slug': categorie.slug}) }}" class="btn btn-outline-success rounded-pill text-capitalize  ">
                    {{ categorie.name }}
                </a>
            {% endfor %}
        </div>
    </div>
    
    {# GRILLE DES PRODUITS RESPONSIVE #}
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
        
       {% for product in products %}
            <div class="col">
                <div class="card product-card shadow-sm h-100 border-green">
                    <h5 class="card-title fw-bold mb-2 text-custom-brown text-center " title="{{ product.title }}">
                            {{ product.title }}
                        </h5>
                    
                    <div class="card-img-wrapper p-3 bg-white" style="border-radius: 10px 10px 0 0;">
                        <img src="{{ product.illustration ? asset('images/' ~ product.illustration) : asset('images/gombo.webp') }}" 
                             class="card-img-top mx-auto d-block" 
                             style="height: 200px; object-fit: contain;" 
                             alt="{{ product.title }}">
                    </div>
                    
                    <div class="card-body d-flex flex-column text-white  border border-warning bg-custom-green " style="border-radius: 0 0 8px 8px;">
                        
                        {# Description courte #}
                        <p class="card-text small opacity-100 flex-grow-1 mb-3">
                            {{ product.description|slice(0, 80) ~ (product.description|length > 80 ? '...' : '') }}
                        </p>
                        
                        {# Section basse : Prix & Boutons #}
                        <div class="mt-auto">
                            {% if app.user %}
                                <p class="card-text text-warning fs-5 fw-semibold mb-3">
                                    {{ product.price }} €
                                </p>
                                
                                <div class="d-flex flex-column gap-2">
                                    {# Bouton Voir Plus #}
                                    <a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn btn-outline-light btn-sm px-4 py-2 rounded-pill transition-all text-center">
                                        Voir plus
                                    </a>
                                    
                                    {# Formulaire d'ajout avec Quantité #}
                                    <form action="{{ path('app_cart_new', {'id': product.id}) }}" method="POST" class="mt-1">
                                        <div class="input-group input-group-sm mb-2">
                                            <span class="input-group-text bg-light text-dark">Qté</span>
                                           <input type="number" name="quantity" class="form-control text-center" placeholder="Qté" min="1" max="100">
                                        </div>
                                        <button type="submit" class="btn btn-custom-brown btn-sm w-100 py-2">
                                            Ajouter au panier
                                        </button>
                                    </form>
                                </div>
                            {% else %}
                                <p class="small text-light opacity-75 mb-0">Connectez-vous pour plus de details</p>
                            {% endif %}
                        </div>
                    </div>

                </div>
             
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <p class="text-muted fs-5">Aucun produit ne correspond à cette catégorie pour le moment.</p>
            </div>
        {% endfor %}
    </div>
       {# Affichage des boutons de navigation #}
<div class="d-flex justify-content-center  my-4">
    {{ knp_pagination_render(products) }}
</div>
</div>
{% endblock %}