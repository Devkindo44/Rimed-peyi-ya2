{% extends 'base.html.twig' %}


{# bloc pour les metadonnées seo#}

{% block title %}{{parent()}} | Catalogue{% endblock %}
{% block description %}{{parent()}} |  Catalogue{% endblock %}
{% block keywords %}{{parent()}} |  Catalogue{% endblock %}
{% block h1 %}Catalogue{% endblock %}







{% block body %}

<div class="row">
{% for product in products %}
    <div class="col-xl-3 col-lg4 col-md-6 p-0">
        <div class="shadow rounded m-2 p-2 text-center">
{# 1. Zone d'affichage de l'image #}
                <div class="mb-3 overflow-hidden rounded" style="height: 200px;">
                    {% if product.illustration %}
                        <img src="{{ asset('uploads/images/' ~ product.illustration) }}" 
                             alt="{{ product.title }}" 
                             class="img-fluid h-100 w-100" 
                             style="object-fit: cover;">
                    {% else %}
                        {# Image par défaut si le produit n'a pas d'illustration #}
                        <img src="{{ asset('images/ ') }}" 
                             alt="Aucune image disponible" 
                             class="img-fluid h-100 w-100" 
                             style="object-fit: cover;">
                    {% endif %}
                </div>

                {# 2. Titre du produit #}
                <h2 class="fs-5 mh48">{{ product.title }}</h2>
            <h2 class="fs-5 mh48">{{ product.title }}</h2>
          
        </div>
    
    </div>





</div>
{% endfor %}

{% endblock %}
