{% extends 'base.html.twig' %}

{# bloc pour les metadonnées seo #}
{% block title %}{{ parent() }} | Catalogue{% endblock %}
{% block description %}{{ parent() }} | Catalogue{% endblock %}
{% block keywords %}{{ parent() }} | Catalogue{% endblock %}
{% block h1 %}Catalogue{% endblock %}

{% block body %}
<div class="container my-5 px-4">

        {# Fil d'ariane #}
    <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ path('app_home') }}">Accueil</a>
        </li>
        {% set current_slug = app.request.attributes.get('slug') %}
        
        {% if current_slug is not empty %}
            <li class="breadcrumb-item">
                <a href="{{ path('app_home_catalogue') }}">Catalogue</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                {# Récupère le nom de la catégorie active s'il y en a une #}
                {% for cat in categories %}
                    {% if cat.slug == current_slug %}{{ cat.name }}{% endif %}
                {% endfor %}
            </li>
        {% else %}
            <li class="breadcrumb-item active" aria-current="page">Tout le catalogue</li>
        {% endif %}
    </ol>
</nav>

        {# Bouton admin #}
    {% if is_granted('ROLE_ADMIN') %}
        <a class="btn btn-custom-green mb-4" href="{{ path('app_admin_user_dashboard') }}">← Tableau de bord</a>
        <a class="btn btn-custom-green mb-4" href="{{ path('app_product_new') }}">Ajouter un produit</a>
    {% endif %}

    

    {# BARRE DE FILTRES DES CATÉGORIES #}
    <div class="text-center mb-5">
        <h2 class="mb-3 text-muted">Rechercher par catégorie :</h2>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            
            {% set current_slug = app.request.attributes.get('slug') %}

            <a href="{{ path('app_home_catalogue') }}" 
               class="btn rounded-pill fw-bold {{ current_slug is empty ? 'btn-warning text-dark shadow-sm' : 'btn-outline-success' }}">
                  Tout le catalogue
            </a>
            
            {% for categorie in categories %}
                <a href="{{ path('app_categories_show', {'slug': categorie.slug}) }}" 
                   class="btn rounded-pill text-capitalize fw-bold {{ current_slug == categorie.slug ? 'btn-warning text-dark shadow-sm' : 'btn-outline-success img-zoom' }}">
                    {{ categorie.name }}
                </a>
            {% endfor %}
        </div>
    </div>
    
    {# GRILLE DES PRODUITS RESPONSIVE #}
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
        
       {% for product in products %}
            <div class="col">
                <div class="card product-card shadow-sm h-100 border-green">
                    <h3 class="card-title fw-bold mb-2 text-custom-brown text-center py-3" title="{{ product.title }}">
                        {{ product.title }}
                    </h3>
                    
                    <div class="card-img-wrapper p-3 bg-white" style="border-radius: 10px 10px 0 0;">
                        <img src="{{ product.illustration ? asset('images/' ~ product.illustration) : asset('images/gombo.webp') }}" 
                             class="card-img-top mx-auto d-block" 
                             style="height: 200px; object-fit: contain;" 
                             alt="{{ product.title }}">
                    </div>
                    
                    <div class="card-body d-flex flex-column text-white border border-warning bg-custom-green" style="border-radius: 0 0 8px 8px;">
                        
                        {# Description courte #}
                        <p class="card-text small opacity-100 flex-grow-1 mb-3">
                            {{ product.description|slice(0, 80) ~ (product.description|length > 80 ? '...' : '') }}
                        </p>
                        
                        {# Section basse : Prix & Boutons #}
                        <div class="mt-auto">
                            {% if app.user %}
                                {% set stockDisponible = product.stock ? product.stock.quantity : 0 %}

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="card-text text-warning fs-5 fw-semibold">
                                        {{ product.price }} €
                                    </span>
                                    {# Badge de contenance / conditionnement #}
                                    {% if stockDisponible > 0 %}
                                    <span class="badge bg-light text-dark opacity-90 text-xs py-1.5 px-2.5 rounded">
                                            {{ product.contenance }} 
                                    </span>
                                    {% else %}
                                    <span class="badge bg-danger text-white opacity-90 text-xs py-1.5 px-2.5 rounded">Rupture de stock</span>
                                    {% endif %}
                                </div>

                                <div class="d-flex flex-column gap-2">
                                    {# Bouton Voir Plus #}
                                    <a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn btn-outline-light btn-sm px-4 py-2 rounded-pill transition-all text-center">
                                        Voir plus
                                    </a>
                                    
                                    {# Formulaire d'ajout avec input type="number" ET boutons flèches physiques #}
                                    <form action="{{ path('app_cart_new', {'id': product.id}) }}" method="POST" class="mt-1">
                                        <div class="input-group input-group-sm mb-2">
                                            <span class="input-group-text bg-custom-brown text-white">Qté</span>
                                            
                                            {# Champ de saisie de type "number" classique avec flèches natives #}
                                            <input type="number" 
                                                   name="quantity" 
                                                   class="form-control text-center " 
                                                   value="{{ stockDisponible > 0 ? 1 : 0 }}" 
                                                   min="{{ stockDisponible > 0 ? 1 : 0 }}" 
                                                   max="{{ min(stockDisponible, 10) }}"
                                                   {% if stockDisponible == 0 %}disabled{% endif %}>

                                            {# Bouton de décrémentation (Flèche Bas) #}
                                            <button class="btn btn-outline-brown text-white bg-custom-brown border px-2.5" 
                                                    type="button" 
                                                    {% if stockDisponible == 0 %}disabled{% endif %}
                                                    onclick="let input = this.parentNode.querySelector('input[name=\'quantity\']'); if(parseInt(input.value) > 1) { input.value = parseInt(input.value) - 1; }">
                                               <span><i class="bi bi-caret-down-fill"></i></span>
                                            </button>

                                            {# Bouton d'incrémentation (Flèche Haut) #}
                                            <button class="btn btn-outline-brown text-white bg-custom-brown border px-2.5" 
                                                    type="button" 
                                                    {% if stockDisponible == 0 %}disabled{% endif %}
                                                    onclick="let input = this.parentNode.querySelector('input[name=\'quantity\']'); let max = parseInt(input.getAttribute('max')); if(parseInt(input.value) < max) { input.value = parseInt(input.value) + 1; }">
                                               <i class="bi bi-caret-up-fill"></i>
                                            </button>
                                        </div>

                                        {% if stockDisponible > 0 %}
                                            <button type="submit" class="btn btn-custom-brown btn-sm w-100 py-2">
                                                Ajouter au panier
                                            </button>
                                        {% else %}
                                            <button type="button" class="btn btn-secondary btn-sm w-100 py-2" disabled>
                                                Indisponible
                                            </button>
                                        {% endif %}
                                    </form>
                                </div>
                            {% else %}
                                <p class="small text-light opacity-75 mb-0 text-center">Connectez-vous pour plus de détails</p>
                            {% endif %}
                        </div>
                    </div>

                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <p class="text-muted fs-5">Aucun produit ne correspond à cette catégorie pour le moment.</p>
            </div>
        {% endfor %}
    </div>

  {# Affichage des boutons de navigation centrés avec du padding #}
    <div class="d-flex justify-content-center my-5">
        {{ knp_pagination_render(products) }}
    </div>
</div>
{% endblock %}