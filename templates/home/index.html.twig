{% extends 'base.html.twig' %}

{# bloc pour les metadonnées seo #}
{% block title %}
	{{ parent() }}
	| Page d'Accueil
{% endblock %}
{% block description %}
	{{ parent() }}
	| Page d'Accueil
{% endblock %}
{% block keywords %}
	{{ parent() }}
	| Page d'Accueil
{% endblock %}
{# 
{% block h1 %}Rimed Péyi ya
{% endblock %} #}

{% block body %}
	<main>

		<div class="container-fluid px-0">
		<div>
			<h1 class="text-center my-3">Rimed peyi ya</h1>
			<h4 class="text-custom-green-l text-center my-2 ">"Remède du pays"</h4>
		</div>
			<div class="row m-0">
			
				<div class="col-12 p-0 position-relative ">
					<img src="{{ asset('/images/ForetArbreVoyageur.jpg') }}" class="hero-image shadow-sm" alt="Forêt avec un arbre du voyageur">
					
		<div class="container py-5">
			<div class="text-center mb-5">
				<h2 class="section-title text-custom-green-l">Liste de nos produits</h2>
				<div class="title-underline mx-auto"></div>
			</div>

			<div id="myCarousel" class="carousel slide pb-5" data-bs-ride="carousel">
				<div class="carousel-inner">
					{% for product in products %}
						<div class="carousel-item {% if loop.first %}active{% endif %}">
							<div class="row justify-content-center">
								<div class="col-10 col-sm-8 col-md-6 col-lg-4">
									<div class="card product-card shadow-sm h-100 border-brown">

										<div class="card-img-wrapper p-3 bg-white" style="border-radius: 10px 10px 0 0;">
											<img src="{{ product.illustration ? asset('images/' ~ product.illustration) : asset('images/gombo.webp') }}" class="card-img-top mx-auto d-block" alt="{{ product.title }}" style="height: 250px; object-fit: contain;">
										</div>

										<div class="card-body text-center bg-custom-green text-white" style="border-radius: 0 0 8px 8px;">
											<h5 class="card-title fw-bold mb-3">{{ product.title }}</h5>

											{% if app.user %}
												<p class="card-text text-warning fs-5 fw-semibold mb-4">{{ product.price }}
													€</p>
												<a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn btn-outline-light btn-sm px-4 py-2 rounded-pill transition-all">
													Voir le produit
												</a>
											{% else %}
												<p class="small text-light opacity-75">Connectez-vous pour plus de details</p>
											{% endif %}
										</div>

									</div>
								</div>
							</div>
						</div>
					{% else %}
						<div class="carousel-item active py-5 text-center">
							<p class="text-muted fs-5">Aucun remède disponible pour le moment.</p>
						</div>
					{% endfor %}
				</div>

				{% if products|length > 1 %}
					<button class="carousel-control-prev" type="button" data-bs-target="#myCarousel" data-bs-slide="prev">
						<span class="carousel-control-prev-icon bg-custom-brown rounded-circle p-3" aria-hidden="true"></span>
						<span class="visually-hidden">Précédent</span>
					</button>
					<button class="carousel-control-next" type="button" data-bs-target="#myCarousel" data-bs-slide="next">
						<span class="carousel-control-next-icon bg-custom-brown rounded-circle p-3" aria-hidden="true"></span>
						<span class="visually-hidden">Suivant</span>
					</button>
				{% endif %}

			</div>
			<h4 class="text-center">reperage</h4>
			<div class="row bg-custom-brown gap-3 mx-auto">
				
				<div class="col-12 col-md-4 bg-custom-cream text-custom-brown rounded-5 shadow ms- me-">
				
						<h4 >Description</h4>
					<p class="ms-2 me-2"> Lorem ipsum dolor sit amet consectetur adipisicing elit. Ea numquam aliquam accusantium tempora adipisci, nulla iure eum ad exercitationem. Fugit sed officia reprehenderit, quae vel in alias maxime repellat totam.</p>
				</div>
				<div class="col-12 col-md-4 bg-custom-cream text-custom-brown rounded-5 shadow ms- me-"> 
				<h4 >evenement</h4>
					<p class="ms-3 me-3">Lorem ipsum dolor sit amet consectetur, adipisicing elit. Possimus vel a necessitatibus voluptates sed odit dolores natus iste deleniti accusantium, perspiciatis consequatur, ab ex vitae velit harum expedita ipsum ipsam!
					Modi consequuntur amet natus delectus ipsum accusamus doloremque ex laborum fugit enim, exercitationem quod omnis voluptate? Minima commodi reiciendis mollitia dolor ab consequuntur non dolores sunt, ullam molestiae quae! Doloribus.</p>
				</div>
				<div class=" col-12 col-md-4 bg-custom-cream text-custom-brown rounded-5 shadow ms- me- ">
					<h4 >News</h4>
					<p class="ms-3 me-3"> Lorem ipsum dolor sit amet consectetur adipisicing elit. Voluptatibus praesentium corporis, assumenda exercitationem ut amet similique nulla nemo molestias saepe impedit sed magnam! Eligendi iure explicabo recusandae amet vitae repellendus. 
					<blockquote>Iste molestias illo magni itaque nihil vero, repellendus maiores esse. Quae, laboriosam? Dolorum libero consequatur sunt officia accusamus, odit ducimus corporis ut, maiores eaque reiciendis provident temporibus, cupiditate repellat iure!</blockquote>
					Eveniet similique enim reprehenderit aperiam nam obcaecati nisi porro dolorem accusantium. Impedit corporis veniam dolor omnis, fugiat nulla est quibusdam vero vitae placeat fugit, asperiores molestiae amet inventore molestias! Ipsa?</p>
					
				</div>
			</div>
				</div>
			</div>
		</div>

		</div>
	</main>
{% endblock %}
