{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block h1 %}Connexion{% endblock %}

{% block body %}
    {# Conteneur principal #}
    <div class="position-relative d-flex align-items-center justify-content-center shadow rounded-5" style="min-height: 100vh; overflow: hidden;">
        
        <button id="monBoutonLogin" class="btn-lg btn-custom-green px-4 btn-glow text-white fw-semibold " style="position:absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(1.5); z-index: 10;">
            Je me connecte
        </button>

        {# L'image en arrière-plan absolu #}
        <img src="{{ asset('images/p-connexion.jpg') }}" 
             class="position-absolute top-0 start-0 w-100 h-100" 
             alt="page de connexion" 
             style="object-fit: cover; z-index: 1; filter: brightness(0.3);">

        <form id="monFormulaireLogin" method="post" class="col-md-4 p-4 shadow rounded btn-custom-cream" style="{% if not error %}display:none;{% endif %} z-index: 10; backdrop-filter: blur(5px);">
           
            
            {% if error %}
            {#  
            error.line is defined and (error.line == 265 or error.line == 67) 
            solution rapide pour remplacer le messge d'erreur symfony "invalid credential"
            bonne pratique => configurer le fichier de traduction symfony (translation/security.fr.yaml)
            
            #}
             {{ error.file }}
                {% if error.line is defined and (error.line == 265 or error.line == 67) %}
                    <div class="alert alert-danger text-center">L'identifiant ou le mot de passe est incorrect.</div>
                {% else %}
                    <div class="alert alert-danger text-center">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}
            {% endif %}

            {% if app.user %}
                <div class="mb-3 text-white text-center fw-bold">
                    Vous êtes connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}" class="text-warning">Déconnexion</a>
                </div>
            {% endif %}
            
            <h1 class="h3 mb-3 font-weight-normal text-center text-white">Connectez-vous</h1>
            
            <div class="text-center mb-3">
                <a href="{{ path('app_register') }}" class="text-white text-decoration-underline small">
                    Pas encore de compte ? Cliquez ici
                </a>
            </div>

            {# Groupe Email #}
            <div class="mb-3 text-start">
                <label for="inputEmail" class="form-label text-white">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="form-control" autocomplete="email" placeholder="votre@email.com" required autofocus>
            </div>

            {# Champ Mot de passe #}
            <div class="mb-3 text-start">
                <label for="inputPassword" class="form-label text-white">Mot de passe</label>
                <input type="password" name="_password" id="inputPassword" class="form-control" autocomplete="current-password" placeholder="Mot de passe" required>
            </div>

            {# Token CSRF #}
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            {# Option Se souvenir de moi & Mot de passe oublié #}
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check mb-0">
                    <input type="checkbox" name="_remember_me" id="remember_me" class="form-check-input">
                    <label class="form-check-label text-white small" for="remember_me">
                        Se souvenir de moi
                    </label>
                </div>
                
                {# Ajout de onclick="event.stopPropagation();" pour éviter le blocage par script.js #}
                <a href="{{ path('app_forgot_password_request') }}" class="text-white-50 small text-decoration-none hover-underline " onclick="event.stopPropagation();">
                    Mot de passe oublié ?
                </a>
            </div>
                
            {# Bouton de connexion #}
            <button class="btn btn-lg btn-custom-green w-100" type="submit">
                Connexion
            </button>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/script.js') }}"></script>
{% endblock %}