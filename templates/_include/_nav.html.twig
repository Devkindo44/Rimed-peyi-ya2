<nav class="navbar navbar-expand-lg bg-custom-green p-0" id="nav">
    <div class="container-fluid">

        {# Logo & Marque #}
        <div class="d-flex align-items-center">
            <a class="navbar-brand d-flex align-items-center me-0" href="{{ path('app_home') }}">
                <img src="{{ asset('images/logo_Projet.png') }}" class="shadow rounded me-2" alt="Logo RimedPeyiYa" width="100">
                <span class="text-white fw-bold me-3">RIMED PEYI YA</span>
            </a>
            <div class="d-flex align-items-center">
                <img src="{{ asset('images/gwada-f.jpg') }}" alt="Drapeau Guadeloupe" width="28" height="21" class="title-animated-pop rounded shadow-sm">
            </div>
        </div>

        {# Bouton Burger pour mobile #}
        <button class="navbar-toggler bg-success-custom-beigeffect" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        {# Le menu pliable #}
        <div class="collapse navbar-collapse" id="navbarNavDropdown">
            <ul class="navbar-nav w-100 align-items-center">

                {# Accueil #}
                <li class="nav-item dropdown ms-4">
                    <div class="d-flex align-items-center">
                        <a class="nav-link text-white" href="{{ path('app_home') }}">Accueil</a>
                        <a class="nav-link dropdown-toggle dropdown-toggle-split text-white" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Plantes médicinales</a></li>
                            <li><a class="dropdown-item" href="#">Remèdes grand-mère</a></li>
                        </ul>
                    </div>
                </li>

                {# Catalogue #}
                <li class="nav-item dropdown">
                    <div class="d-flex align-items-center">
                        <a class="nav-link text-white" href="{{ path('app_home_catalogue') }}">Catalogue</a>
                        <a class="nav-link dropdown-toggle dropdown-toggle-split text-white" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item fw-bold" href="{{ path('app_home_catalogue') }}">Tous les produits</a></li>
                            <li><hr class="dropdown-divider"></li>
                            {% for category in categories %}
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_home_catalogue', {'category': category.id}) }}">
                                        {{ category.name }}
                                    </a>
                                </li>
                            {% else %}
                                <li><span class="dropdown-item text-muted">Aucune catégorie disponible</span></li>
                            {% endfor %}
                        </ul>
                    </div>
                </li>

                {# Catégories #}
                <li class="nav-item">
                    <a class="nav-link text-white" href="{{ path('app_categories') }}">Catégories</a>
                </li>

                {# Liens Administration #}
                {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item">
                        <a class="nav-link text-white" href="{{ path('app_product_index') }}">Gestion des produits</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="{{ path('app_admin_categories_dashboard') }}">Gestion des catégories</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="{{ path('app_admin_user_dashboard') }}">Espace Administrateur</a>
                    </li>
                {% endif %}

                {# PANIER (Pousse tout à droite si connecté) #}
                {% if app.user %}
                    <li class="nav-item ms-auto me-3">
                        <a class="nav-link text-white position-relative d-flex align-items-center" href="{{ path('app_cart') }}">
                            {{ ux_icon('lucide:shopping-cart', {class: 'me-1 icon20'}) }}
                            Panier
                            <span class="badge rounded-pill bg-warning text-dark ms-2">
                                {{ app.session.get('cart', [])|reduce((total, qty) => total + (qty matches '/^\\d+$/' ? qty : 0), 0) }}
                            </span>
                        </a>
                    </li>
                {% endif %}

                {# ESPACE CLIENT (Prend 'ms-auto' si PAS de panier/utilisateur) #}
                <li class="nav-item dropdown {% if not app.user %}ms-auto{% else %}me-2{% endif %}">
                    <a class="nav-link dropdown-toggle text-white" href="#" id="navbarDropdownClient" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Espace client
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdownClient">
                        {% if app.user %}
                            <li>
                                <span class="dropdown-item-text text-muted fw-bold">
                                    <i class="bi bi-person-fill-check text-success me-1"></i> Bonjour {{ app.user.firstname|capitalize }}
                                </span>
                                <a class="dropdown-item d-flex align-items-center" href="{{ path('app_profile') }}">
                                    <i class="bi bi-person-badge text-primary me-2"></i>
                                    <span class="text-primary">Mon profil</span>
                                </a>
                                <a class="dropdown-item d-flex align-items-center" href="{{ path('app_commande_index') }}">
                                    <i class="bi bi-receipt text-success me-2"></i>
                                    <span class="text-muted">Mes commandes</span>
                                </a>
                            </li>

                            <li><hr class="dropdown-divider"></li>

                            {% if is_granted('ROLE_ADMIN') %}
                                <li>
                                    <a class="dropdown-item d-flex align-items-center" href="{{ path('app_admin_user') }}">
                                        <i class="bi bi-back me-2 text-primary"></i>
                                        <span class="text-primary">Back office</span>
                                    </a>
                                </li>
                            {% endif %}

                            <li>
                                <a class="dropdown-item text-danger d-flex align-items-center" href="{{ path('app_logout') }}">
                                    <i class="bi bi-person-fill-lock me-2"></i>Déconnexion
                                </a>
                            </li>
                        {% else %}
                            <li>
                                <a class="dropdown-item" href="{{ path('app_login') }}">Connexion</a>
                            </li>
                        {% endif %}
                    </ul>
                </li>

                {# BOUTON DÉCONNEXION RAPIDE (À droite d'Espace client) #}
                {% if app.user %}
                    <li class="nav-item">
                        <a class="btn btn-light btn-sm ms-2 d-flex align-items-center" href="{{ path('app_logout') }}">
                            <i class="bi bi-box-arrow-right me-1"></i> Déconnexion
                        </a>
                    </li>
                {% endif %}

            </ul>
        </div>

    </div>
</nav>