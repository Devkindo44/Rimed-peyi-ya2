{% for notification in app.flashes('success') %}
    <div class="alert alert-success text-center col-md-6 w-50 mx-auto text-center my-2">
        {{notification}}
    
    </div>
{% endfor %}

{% for notification in app.flashes('warning') %}
    <div class="alert alert-warning text-center col-md-6 w-50 mx-auto text-center my-2">
        {{notification}}
    
    </div>
{% endfor %}

{% for notification in app.flashes('info') %}
    <div class="alert alert-info text-center col-md-6 w-50 mx-auto text-center my-2">
        {{notification}}
    
    </div>
{% endfor %}

{% for notification in app.flashes('error') %}
    <div class="alert alert-danger text-center col-md-6 w-50 mx-auto text-center my-2">
        {{notification}}
    
    </div>
{% endfor %}
