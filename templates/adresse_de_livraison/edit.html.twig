{% extends 'base.html.twig' %}

{% block title %}Modifier l'adresse de livraison{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header text-white" style="background-color: var(--main-green) !important;">
                    <h1 class="h4 mb-0 py-1">Modifier mon adresse de livraison</h1>
                </div>

                <div class="card-body bg-light p-4">
                    {# Formulaire principal de modification #}
                    {{ include('adresse_de_livraison/_form.html.twig', {
                        'button_label': ' Enregistrer mes modifications'
                    }) }}

                    <hr class="my-4">

                    {# Zone d'actions : Retour à la liste & Suppression #}
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <a href="{{ path('app_profile') }}" class="btn btn-custom-brown">
                            Retour à mon profil
                        </a>

                        {# Formulaire de suppression #}
                        {{ include('adresse_de_livraison/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}