{% extends 'base.html.twig' %}

{% block title %}Ajouter une adresse de livraison{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header text-white" style="background-color: var(--main-green) !important;">
                    <h1 class="h4 mb-0 py-1">Ajouter une adresse de livraison</h1>
                </div>

                <div class="card-body bg-light p-4">
                    {# Formulaire principal de création #}
                    {{ include('adresse_de_livraison/_form.html.twig', {
                        'button_label': ' Ajouter cette adresse'
                    }) }}

                    <hr class="my-4">

                    {# Action : Retour au profil #}
                    <div class="d-flex justify-content-start">
                        <a href="{{ path('app_profile') }}" class="btn btn-custom-brown">
                            Retour à mon profil
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}