{% extends 'base.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block body %}
    {% if is_granted('ROLE_ADMIN') %}
        <div class="container mt-3">
            <a href="{{ path('app_admin_user') }}" class="btn btn-custom-green">
                ← Tableau de bord
            </a>
        </div>
    {% endif %}

    <div class="container mt-5">
        <h1>Mon Panier</h1>
        
        {% if items is empty %}
            <div class="border border-success text-center shadow p-5 mx-auto rounded">
                <div class="alert alert-info">
                    Actuellement, votre panier ne contient aucun produit.
                </div>
                <a href="{{ path('app_home_catalogue') }}" class="btn btn-outline-green2">Continuer mes achats</a>
            </div>
        {% else %}
            <div class="border border-success text-center shadow mx-auto p-3 rounded bg-white">
                <table class="table table-bordered mt-4 align-middle">
                    <thead>
                        <tr>
                            <th class="text-white py-3" style="background-color: var(--main-green) !important;">Nom du Produit</th>
                            <th class="text-white py-3" style="background-color: var(--main-green) !important;">Prix unitaire</th>
                            <th class="text-white py-3" style="background-color: var(--main-green) !important;">Quantité</th>
                            <th class="text-white py-3" style="background-color: var(--main-green) !important;">Total</th>
                            <th class="text-white py-3" style="background-color: var(--main-green) !important;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in items %}
                            <tr>
                                <td>{{ item.product.title }}</td>
                                <td>{{ item.product.price }} €</td>
                                <td>
                                    <div class="d-flex justify-content-center align-items-center gap-2">
                                        {# Bouton Moins (-) #}
                                        <a href="{{ path('app_cart_decrease', {'id': item.product.id}) }}" class="btn btn-sm text-decoration-none" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Réduire la quantité">
                                            {{ ux_icon('lucide:circle-minus', {class: 'text-custom-brown icon25'}) }}
                                        </a>

                                        {# Quantité actuelle #}
                                        <span class="fs-5 px-2">{{ item.quantity }}</span>

                                        {# Bouton Plus (+) #}
                                        <a href="{{ path('app_cart_increase', {'id': item.product.id}) }}" class="btn btn-sm text-decoration-none" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Augmenter la quantité">
                                            {{ ux_icon('lucide:circle-plus', {class: 'text-custom-brown icon25'}) }}
                                        </a>
                                    </div>
                                </td>
                                <td>{{ item.product.price * item.quantity }} €</td>
                                <td>
                                    <form action="{{ path('app_cart_remove') }}" method="POST" onsubmit="return confirm('Voulez-vous vraiment vider votre panier ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('clear_cart') }}">
                                        <button type="submit" class="btn btn-outline-danger">Vider le panier</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>

                <div class="text-end my-4 pe-3">
                    <h3 class="fw-bold">Total : <span class="text-success">{{ total }} €</span></h3>
                </div>
            </div> {# <-- La balise fermante a été déplacée ici pour bien englober le tableau #}

            {# BARRE DE BOUTONS D'ACTION #}
            <div class="row mx-auto justify-content-between mb-5 gap-2">
                <a href="{{ path('app_home_catalogue') }}" class="btn btn-outline-success col-lg-3 mt-3 rounded-pill">
                    Continuer mes achats
                </a>
                
                {# MODIFICATION ICI : Lien connecté au CommandeController #}
                <a href="{{ path('app_commande_creer') }}" class="btn btn-success col-lg-3 mt-3 rounded-pill text-white fw-semibold">
                    Valider la commande
                </a>
                
                <a href="{{ path('app_cart_remove') }}" class="btn btn-outline-danger col-lg-3 mt-3 rounded-pill">
                    Supprimer le panier
                </a>
            </div>
        {% endif %}
    </div>
{% endblock %}