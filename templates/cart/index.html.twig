{% extends 'base.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1>Mon Panier</h1>

    {% if items is empty %}
        <div class="alert alert-info mt-4">
            Votre panier est vide pour le moment.
        </div>
        <a href="#" class="btn btn-primary">Continuer mes achats</a>
    {% else %}
        <table class="table table-bordered mt-4">
            <thead>
                <tr>
                    <th>Produit</th>
                    <th>Prix unitaire</th>
                    <th>Quantité</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>{{ item.product.title }}</td>
                        <td>{{ item.product.price }} €</td>
                        <td>{{ item.quantity }}</td>
                        <td>{{ item.product.price * item.quantity }} €</td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-end fw-bold">Total Général :</td>
                    <td class="fw-bold text-success">{{ total }} €</td>
                </tr>
            </tfoot>
        </table>

        <div class="d-flex justify-content-between mt-4">
            <a href="{{ path('app_home_catalogue') }}"class="btn btn-secondary">Continuer mes achats</a>
            <a href="#" class="btn btn-success">Passer à la caisse</a>
        </div>
    {% endif %}
</div>
{% endblock %}