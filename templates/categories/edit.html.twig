{% extends 'base.html.twig' %}

{% block stylesheets %}{% endblock %}

{% block title %}Modifier une Categorie{% endblock %}
    
{% block h1 %}Modifier une Categorie{% endblock %}


{% block body %}
<div class="container mt-4">
   <a class="btn btn-custom-green mb-3" href="{{ path('app_categories') }}">
        Retour à la gestion des catégories
    </a>
        <div class="col-md-4 mx-auto p-4 m-3 shadow bg-white rounded"> 
            <h1 class="h3 mb-3 font-weight-normal text-center">Modifier une Catégorie</h1>
            
            {{ form_start(form) }}
                {{ form_row(form.name, {'attr': {'class': 'form form-control'}}) }}

                <button type="submit" class="btn btn-lg btn-custom-brown w-100 mt-3">Modifier</button>
            {{ form_end(form) }}
        </div>
</div>

{% endblock %}