{% extends 'base.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block body %}
<div class="container my-5">
    {# Fil d'ariane #}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_categories') }}">Catégories</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ category.name }}</li>
        </ol>
    </nav>

    {# Personnalisation du bandeau ou de l'introduction selon le slug de la catégorie #}
    <div class="p-5 mb-4 bg-light rounded-3  shadow-sm ">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold">{{ category.name }}</h1>
            
            {% if category.slug == 'infusions' %}
                <p class="col-md-8 fs-4">Prenez soin de vous avec notre sélection d'infusions locales, douces et réconfortantes.</p>
            {% elseif category.slug == 'sirops' %}
                <p class="col-md-8 fs-4">Découvrez nos sirops artisanaux à base de plantes pour napper vos desserts ou agrémenter vos boissons.</p>
            {% elseif category.slug == 'plantes' %}
                <p class="col-md-8 fs-4">Nos plantes brutes, séchées avec soin pour conserver toutes leurs propriétés naturelles.</p>
            {% elseif category.slug == 'recettes' %}
                <p class="col-md-8 fs-4">Retrouvez toutes les fiches recettes et secrets de préparation de nos remèdes traditionnels.</p>
            {% else %}
                <p class="col-md-8 fs-4">Explorez tous les produits associés à notre gamme "{{ category.name }}".</p>
            {% endif %}
        </div>
    </div>

    {# Grille des produits associés #}
    <h2 class="mt-5 mb-4">Les produits de cette catégorie</h2>
    <div class="row g-4">
        {% for product in category.products %}
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <img src="{{ asset('images/' ~ product.illustration) }}" class="card-img-top" alt="{{ product.title }}" style="object-fit: cover; height: 200px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">{{ product.title }}</h5>
                        <p class="card-text text-muted">{{ product.description|slice(0, 100) }}...</p>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between align-items-center pb-3">
                        <span class="text-success fw-bold fs-5">{{ product.price }} €</span>
                        <a href="{{ path('app_product_show', {'id':product.id}) }}" class="btn btn-outline-dark btn-sm">Voir le produit</a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <div class="alert alert-warning border-0 shadow-sm">
                    Aucun produit n'est encore lié à la catégorie "{{ category.name }}".
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}