{% extends 'base.html.twig' %}

{% block stylesheets %}{% endblock %}

{% block title %}Ajouter une Categories{% endblock %}
    
{% block h1 %}Ajouter une Categorie{% endblock %}


{% block body %}

   
    <a class="btn btn-custom-green"href="{{path('app_categories')}}">Gestion des categories</a>
       
    </a>
   
    {# div pour le design  #}
    <div class="col-md-4 mx-auto p-4 m-3 shadow btn-custom-green"> 

        {{ form_start(form) }}
        
            <div class="mb-3">
               {{ form_row(form.name, {
                    'attr': {'class': 'form form-control'}
               }) }}
            </div>

            <button type="submit" class="btn btn-lg btn-custom-brown w-100">Sauvegarder</button>

        {{ form_end(form) }}
        
    </div>

{% endblock %}


