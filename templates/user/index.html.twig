{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Gestion des membres{% endblock %}
{% block description %}{{ parent() }} | Gestion des membres{% endblock %}
{% block keywords %}{{ parent() }} |  Gestion des membres{% endblock %}
{% block h1 %}Gestion des membres{% endblock %}

{% block body %}

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label == 'danger' or label == 'error' ? 'danger' : (label == 'success' ? 'success' : 'info') }} alert-dismissible fade show m-3" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
{% endfor %}

<div class="container mt-4">
    {# Boutons de navigation #}
    <div class="mb-3">
        <a href="{{ path('app_admin_user_dashboard') }}" class="btn btn-custom-green">
            ← Tableau de bord
        </a>
        <a class="btn btn-custom-green" href="{{ path('app_user_new') }}">
            Ajouter un membre
        </a>
    </div>

    {% if users is not empty %}
        <table class="table table-striped vertical-align-middle mb-0 table-bordered table-hover text-center text-white mt-3">
            <thead>
                <tr>
                    <th class="text-white py-3" style="background-color: var(--main-green) !important; width: 70px;">ID</th>
                    <th class="text-white py-3" style="background-color: var(--main-green) !important;">Prénom</th>
                    <th class="text-white py-3" style="background-color: var(--main-green) !important;">Nom</th>
                    <th class="text-white py-3" style="background-color: var(--main-green) !important;">Email</th>
                    <th class="text-white py-3" style="background-color: var(--main-green) !important; width: 120px;">Statut</th>
                    <th class="text-white py-3" style="background-color: var(--main-green) !important; width: 110px;">Rôles</th>
                    <th class="text-white py-3" style="background-color: var(--main-green) !important;">Téléphone</th>
                    <th class="text-white py-3" style="background-color: var(--main-green) !important; width: 160px;">Date d'inscription</th>
                    <th class="text-white py-3" style="background-color: var(--main-green) !important; width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.id }}</td>
                        <td>{{ user.firstName|capitalize }}</td>
                        <td>{{ user.lastName|upper }}</td>
                        <td class="text-start px-3">{{ user.email }}</td>
                        <td>
                            {% if user.isVerified %}
                                <span class="badge bg-success">✓ Vérifié</span>
                            {% else %}
                                <span class="badge bg-warning text-dark">⚠ En attente</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if 'ROLE_ADMIN' in user.roles %}
                                <span class="badge bg-oj text-danger">Admin</span>
                            {% else %}
                                <span class="badge bg-custom-brown">Membre</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if user.numeroDeTelephone %}
                                {{ user.numeroDeTelephone }}
                            {% else %}
                                <span class="text-muted small"><em>Aucun</em></span>
                            {% endif %}
                        </td>
                        <td>
                            {% if user.createdAt %}
                                {{ user.createdAt|date('d/m/Y à H:i') }}
                            {% else %}
                                <span class="text-muted small"><em>Inconnue</em></span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="d-flex justify-content-center align-items-center gap-3">
                                <a href="{{ path('app_user_show', {'id': user.id}) }}" class="text-decoration-none" title="Voir la fiche">
                                    {{ ux_icon('lucide:eye', {class: 'text-info icon20'}) }}
                                </a>
                                <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="text-decoration-none" title="Modifier">
                                    {{ ux_icon('lucide:edit', {class: 'text-primary icon20'}) }}
                                </a>
                                <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce membre ?');" style="display: inline-block;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                    <button class="btn btn-link p-0 m-0 align-baseline text-decoration-none" type="submit" title="Supprimer">
                                        {{ ux_icon('lucide:trash-2', {class: 'text-danger icon20'}) }}
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div class="alert alert-info mt-3">
            {{ ux_icon('lucide:info', {class: 'me-2'}) }} Aucun utilisateur trouvé dans la base de données.
        </div>
    {% endif %}
</div>

{% endblock %}