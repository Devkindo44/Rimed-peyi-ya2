{% extends 'base.html.twig' %}

{% block title %}User index{% endblock %}

{% block body %}
    <h1>User index</h1>
 <a class="btn btn-custom-green"href="{{path('app_admin_user_index')}}">Gestion des membres</a>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Password</th>
                <th>FirstName</th>
                <th>LastName</th>
                <th>IsVerified</th>
                <th>Numero_de_telephone</th>
               
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
                <td>{{ user.password }}</td>
                <td>{{ user.firstName }}</td>
                <td>{{ user.lastName }}</td>
                <td>{{ user.isVerified ? 'Yes' : 'No' }}</td>
                <td>{{ user.eMail }}</td>
                <td>{{ user.numeroDeTelephone }}</td>
                <td>
                    <a btn btn-custom-green href="{{ path('app_user_show', {'id': user.id}) }}">show</a>
                    <a class="btn btn-custom-green"href="{{ path('app_user_edit', {'id': user.id}) }}">edit</a>
                    <a class="btn btn-custom-green" href="{{ path('app_user_delete', {'id': user.id}) }}">delete</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="11">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="btn btn-custom-green" href="{{ path('app_user_new') }}">Create new</a>
{% endblock %}
