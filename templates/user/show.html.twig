{% extends 'base.html.twig' %}

{% block title %}User{% endblock %}

{% block body %}
    <h1>User</h1>
  <a class="btn btn-custom-green"href="{{path('app_user_index')}}">Gestion des membres</a>
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ user.id }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ user.email }}</td>
            </tr>
            <tr>
                <th>Roles</th>
                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>Password</th>
                <td>{{ user.password }}</td>
            </tr>
            <tr>
                <th>FirstName</th>
                <td>{{ user.firstName }}</td>
            </tr>
            <tr>
                <th>LastName</th>
                <td>{{ user.lastName }}</td>
            </tr>
            <tr>
                <th>IsVerified</th>
                <td>{{ user.isVerified ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Numero_de_telephone</th>
                <td>{{ user.numeroDeTelephone }}</td>
            </tr>
        </tbody>
    </table>

    <a class="btn btn-custom-green" href="{{ path('app_user_index') }}">back to list</a>

  <a class="btn btn-custom-green" href="{{ path('app_user_new', {'id': user.id}) }}">new</a>
    <a class="btn btn-custom-green" href="{{ path('app_user_edit', {'id': user.id}) }}">edit</a>
    <a  {{ include('user/_delete_form.html.twig') }}</a>

   
{% endblock %}
