{% extends 'base.html.twig' %}

{% block title %}Ajouter un utilisateur{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm border-green rounded-4 overflow-hidden bg-white">
                
                {# En-tête de la carte #}
                <div class="card-header bg-custom-green text-white fw-bold py-3 border-0">
                    <h1 class="h5 mb-0"><i class="bi bi-person-plus-fill me-2"></i>Ajouter un utilisateur</h1>
                </div>

                <div class="card-body p-4">
                    {# Formulaire principal de création #}
                    {{ include('user/_form.html.twig', {
                        'button_label': 'Créer l\'utilisateur'
                    }) }}

                    <hr class="my-4 opacity-25">

                    {# Action : Retour à la gestion des membres #}
                    <div class="d-flex justify-content-start">
                        <a href="{{ path('app_admin_user') }}" class="btn btn-custom-brown rounded-3">
                            ← Retour à la gestion des membres
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
{% endblock %}