{% extends 'base.html.twig' %}

{% block main_class %}container-fluid p-0 m-0{% endblock %}

{% block nav %}{% endblock %}
{% block footer %}{% endblock %}

{% block title %}Back Office - Administration{% endblock %}
{% block h1 %}{% endblock %}

{% block body %}



<div class="d-flex flex-column flex-md-row min-vh-100 w-100 m-0 p-0 bg-cream">

    {# --- SIDEBAR BARRE DE NAVIGATION --- #}
    <aside class="sidebar flex-shrink-0 p-3 p-md-4 bg-custom-cream shadow-regular">
        {# Logo et titre #}
        <div class="logo text-custom-brown text-center mb-3 mb-md-4">
            <img src="{{ asset('images/logo_Projet.png') }}" alt="logo" class="img-fluid mb-2" style="max-width: 75px;">
            <h2 class="h5 fw-bold mb-0">AdminPanel</h2>
        </div>

        {# Navigation #}
        <nav class="nav-links d-flex flex-column gap-2">
            <a href="{{ path('app_home') }}" target="_blank" class="btn bg-custom-green-admin text-start shadow-sm fw-semibold rounded-3 d-flex align-items-center gap-2">
                <span><i class="bi bi-eye-fill"></i></span> <span>Voir le site public</span>
            </a>

            <hr class="text-muted my-2 opacity-25">

            <a href="{{ path('app_admin_user') }}" class="btn bg-custom-green-admin text-start rounded-3 d-flex align-items-center gap-2">
                <span><i class="bi bi-people-fill"></i></span> <span>Utilisateurs</span>
            </a>
            
            <a href="{{ path('app_product_index') }}" class="btn bg-custom-green-admin text-start rounded-3 d-flex align-items-center gap-2">
                <span><i class="bi bi-bag-fill"></i></span> <span>Produits</span>
            </a>
            
            <a href="{{ path('app_admin_categories_dashboard') }}" class="btn bg-custom-green-admin text-start rounded-3 d-flex align-items-center gap-2">
                <span><i class="bi bi-grid-fill"></i></span> <span>Catégories</span>
            </a>

            <a href="{{ path('app_admin_commande_dashboard') }}" class="btn bg-custom-green-admin text-start rounded-3 d-flex align-items-center gap-2">
                <span><i class="bi bi-receipt me-2"></i></span> <span>Commandes</span>
            </a>

            <a href="{{ path('app_admin_adresse_de_livraison_index') }}" class="btn bg-custom-green-admin text-start rounded-3 d-flex align-items-center gap-2">
                <span><i class="bi bi-geo-alt"></i></span> <span>Adresses</span>
            </a>
            
            <a href="{{ path('app_cart') }}" class="btn bg-custom-green-admin text-start rounded-3 d-flex align-items-center gap-2">
                <span><i class="bi bi-cart-fill"></i></span> <span>Accès panier</span>
            </a>
            
            <a href="{{ path('app_logout') }}" class="btn btn-outline-danger text-start mt-3 fw-bold rounded-3 d-flex align-items-center gap-2">
                <span><i class="bi bi-person-fill-lock me-2"></i></span> <span>Déconnexion</span>
            </a>
        </nav>
    </aside>

    {# --- CONTENU PRINCIPAL DE L'ADMINISTRATION --- #}
    {% if app.user %}
        <main class="flex-grow-1 p-3 p-md-5">
            
            {# En-tête de bienvenue #}
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center pb-3 mb-4 border-bottom gap-3">
                <div>
                    <h1 class="fw-bold text-custom-green-l mb-1 fs-2 fs-md-1">Tableau de bord</h1>
                    <p class="text-muted small mb-0">Bonjour admin, <strong class="text-dark"><i class="bi bi-shield-lock-fill text-success"></i>{{ app.user.firstname|capitalize }}</strong> !</p>
                </div>
                <div>
                    <span class="badge bg-custom-green px-3 py-2 fs-6 rounded-pill shadow-sm">
                        Connecté en tant qu'Administrateur
                    </span>
                </div>
            </div>

            {# --- SECTION 1 : STATISTIQUES RAPIDES (KPIs) --- #}
            <div class="row g-3 mb-4 mb-md-5">
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm border-start border-4 border-primary rounded-4 h-100 bg-white">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fw-semibold text-uppercase fs-7 tracking-wider">Utilisateurs</span>
                                <h2 class="h3 fw-bold my-1 text-dark">{{ totalUsers }}</h2>
                                <a href="{{ path('app_admin_user') }}" class="small text-primary text-decoration-none fw-semibold">Voir la liste →</a>
                            </div>
                            <div class="p-2 bg-primary bg-opacity-10 rounded-circle text-primary fs-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <span><i class="bi bi-people-fill"></i></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm border-start border-4 border-success rounded-4 h-100 bg-white">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fw-semibold text-uppercase fs-7 tracking-wider">Catégories</span>
                                <h2 class="h3 fw-bold my-1 text-dark">{{ totalCategories }}</h2>
                                <a href="{{ path('app_admin_categories_dashboard') }}" class="small text-success text-decoration-none fw-semibold">Gérer les catégories →</a>
                            </div>
                            <div class="p-2 bg-success bg-opacity-10 rounded-circle text-success fs-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <span><i class="bi bi-grid-fill"></i></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm border-start border-4 border-warning rounded-4 h-100 bg-white">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fw-semibold text-uppercase fs-7 tracking-wider">Produits en vente</span>
                                <h2 class="h3 fw-bold my-1 text-dark">{{ totalProducts }}</h2>
                                <a href="{{ path('app_product_index') }}" class="small text-warning text-decoration-none fw-semibold">Voir l'inventaire →</a>
                            </div>
                            <div class="p-2 bg-warning bg-opacity-10 rounded-circle text-warning fs-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <span><i class="bi bi-bag-fill"></i></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm border-start border-4 border-info rounded-4 h-100 bg-white">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fw-semibold text-uppercase fs-7 tracking-wider">Commandes</span>
                                <h2 class="h3 fw-bold my-1 text-dark">{{ totalCommandes }}</h2>
                                <a href="{{ path('app_admin_commande_dashboard') }}" class="small text-info text-decoration-none fw-semibold">Voir les commandes →</a>
                            </div>
                            <div class="p-2 bg-info bg-opacity-10 rounded-circle text-info fs-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <span><i class="bi bi-receipt"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# --- SECTION 2 : ACCÈS RAPIDES AUX ACTIONS --- #}
            <div class="d-flex align-items-center mb-4">
                <h2 class="h5 fw-bold text-secondary mb-0">Actions rapides</h2>
                <div class="flex-grow-1 ms-3 border-bottom opacity-50"></div>
            </div>
            
            <div class="row g-3 mb-4">
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm border-green rounded-4 overflow-hidden">
                        <div class="card-header bg-custom-green text-white fw-bold py-2 border-0 small">
                            <h5 class="mb-0 fs-6"><span><i class="bi bi-people-fill me-2"></i></span>Gestion des Utilisateurs</h5> 
                        </div>
                        <div class="card-body p-3 d-flex flex-column gap-2 bg-white">
                            <a href="{{ path('app_admin_user') }}" class="btn btn-sm btn-custom-brown text-start rounded-3">
                                <span><i class="bi bi-people-fill me-2"></i></span> Liste des membres
                            </a>
                            <a href="{{ path('app_user_new') }}" class="btn btn-sm btn-custom-brown text-start rounded-3">
                                <span><i class="bi bi-person-add me-2"></i></span> Ajouter un membre
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm border-green rounded-4 overflow-hidden">
                        <div class="card-header bg-custom-green text-white fw-bold py-2 border-0 small">
                           <h5 class="mb-0 fs-6"><span><i class="bi bi-grid-fill me-2"></i></span> Gestion des Catégories</h5> 
                        </div>
                        <div class="card-body p-3 d-flex flex-column gap-2 bg-white">
                            <a href="{{ path('app_admin_categories_dashboard') }}" class="btn btn-sm btn-custom-brown text-start rounded-3">
                                <span><i class="bi bi-list me-2"></i></span> Liste des catégories
                            </a>
                            <a href="{{ path('app_categories_new') }}" class="btn btn-sm btn-custom-brown text-start rounded-3">
                               <span><i class="bi bi-plus-circle me-2"></i></span> Ajouter une catégorie
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm border-green rounded-4 overflow-hidden">
                        <div class="card-header bg-custom-green text-white fw-bold py-2 border-0 small">
                           <h5 class="mb-0 fs-6"><span><i class="bi bi-bag-fill me-2"></i></span> Gestion des Produits</h5>
                        </div>
                        <div class="card-body p-3 d-flex flex-column gap-2 bg-white">
                            <a href="{{ path('app_product_index') }}" class="btn btn-sm btn-custom-brown text-start rounded-3">
                                <span><i class="bi bi-list me-2"></i></span> Liste des produits
                            </a>
                            <a href="{{ path('app_product_new') }}" class="btn btn-sm btn-custom-brown text-start rounded-3">
                                <span><i class="bi bi-plus-circle me-2"></i></span> Ajouter un produit
                            </a>
                        </div> 
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm border-green rounded-4 overflow-hidden">
                        <div class="card-header bg-custom-green text-white py-2 fw-bold border-0 small">
                          <h5 class="mb-0 fs-6"><span><i class="bi bi-receipt me-2"></i></span>Gestion des Commandes</h5>
                        </div>
                        <div class="card-body p-3 bg-white d-flex flex-column justify-content-between">
                            <p class="text-muted small mb-2">Consultez l'historique global des achats.</p>
                            <a href="{{ path('app_admin_commande_dashboard') }}" class="btn btn-sm btn-custom-brown w-100 rounded-3">
                                <span><i class="bi bi-eye-fill me-2"></i></span>Voir toutes les commandes
                            </a>
                        </div> 
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm border-green rounded-4 overflow-hidden">
                        <div class="card-header bg-custom-green text-white py-2 fw-bold border-0 small">
                          <h5 class="mb-0 fs-6"><span><i class="bi bi-geo-alt me-2"></i></span> Gestion des Adresses</h5>
                        </div>
                        <div class="card-body p-3 d-flex flex-column gap-2 bg-white">
                            <a href="{{ path('app_admin_adresse_de_livraison_index') }}" class="btn btn-sm btn-custom-brown text-start rounded-3">
                                <span><i class="bi bi-list me-2"></i></span> Liste des adresses
                            </a>
                            <a href="{{ path('app_adresse_de_livraison_new') }}" class="btn btn-sm btn-custom-brown text-start rounded-3">
                               <span><i class="bi bi-plus-circle me-2"></i></span>Créer une adresse
                            </a>
                        </div> 
                    </div>
                </div>

            </div>
        </main>
    {% else %}
        <div class="flex-grow-1 d-flex justify-content-center align-items-center p-4">
            <div class="alert alert-danger text-center shadow-sm px-4 py-4 rounded-4" role="alert">
                <h4 class="alert-heading fw-bold mb-2">Accès refusé</h4>
                <p class="mb-0">Vous devez être connecté pour accéder à cette section d'administration.</p>
            </div>
        </div>
    {% endif %}

</div>
{% endblock %}