{% extends 'base.html.twig' %}

{% block main_class %}container-fluid p-0 m-0{% endblock %}

{% block nav %}{% endblock %}
{% block footer %}{% endblock %}

{% block title %}Back Office - Administration{% endblock %}
{% block h1 %}{% endblock %}

{% block body %}
<div class="d-flex flex-column flex-md-row min-vh-100 w-100 m-0 p-0">

    {# --- SIDEBAR BARRE DE NAVIGATION --- #}
    <aside class="sidebar flex-shrink-0 p-3 d-flex flex-column" style="width: 280px;">
        <div class="logo text-custom-brown text-center mb-4">
            <h2 class="h4 fw-bold">AdminPanel</h2>
            <img src="{{ asset('images/logo_Projet.png') }}" alt="logo" class="img-fluid my-2" style="max-width: 100px;">
        </div>

        <nav class="nav-links d-flex flex-column gap-2 flex-grow-1">
            <a href="{{ path('app_home') }}" target="_blank" class="btn bg-custom-green-admin text-start shadow-sm fw-semibold">
                🌐 Voir le site public
            </a>

            <hr class="text-muted my-2">

            <a href="{{ path('app_admin_user') }}" class="btn bg-custom-green-admin text-start">
                👥 Utilisateurs
            </a>
            
            <a href="{{ path('app_product_index') }}" class="btn bg-custom-green-admin text-start">
                🌿 Produits
            </a>
            
            <a href="{{ path('app_admin_categories_dashboard') }}" class="btn bg-custom-green-admin text-start">
                📁 Catégories
            </a>

            <a href="{{ path('app_admin_commande_dashboard') }}" class="btn bg-custom-green-admin text-start">
                📦 Commandes
            </a>

            <a href="{{ path('app_admin_adresse_de_livraison_index') }}" class="btn bg-custom-green-admin text-start">
                📍 Adresses
            </a>
            
            <a href="{{ path('app_cart') }}" class="btn bg-custom-green-admin text-start">
                🛒 Accès panier
            </a>
            
            <a href="{{ path('app_logout') }}" class="btn btn-danger text-start mt-auto fw-bold">
                🚪 Déconnexion
            </a>
        </nav>
    </aside>

    {# --- CONTENU PRINCIPAL DE L'ADMINISTRATION --- #}
    {% if app.user %}
        <main class="flex-grow-1 bg-light p-4">
            
            {# En-tête de bienvenue #}
            <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
                <div>
                    <h1 class="h3 fw-bold text-custom-green-l m-0">Tableau de bord</h1>
                    <small class="text-muted">Ravi de vous revoir, {{ app.user.firstname|capitalize }} !</small>
                </div>
                <div class="badge bg-custom-green px-3 py-2 fs-6 rounded-pill">
                    Connecté en tant qu'Administrateur
                </div>
            </div>

            {# --- SECTION 1 : STATISTIQUES RAPIDES (KPIs) --- #}
            <div class="row g-3 mb-4">
                {# Membres #}
                <div class="col-xl-4 col-md-6">
                    <div class="card border-0 shadow-sm border-start border-4 border-primary h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fw-semibold text-uppercase fs-7">Utilisateurs</span>
                                <h2 class="fw-bold my-1 text-dark">{{ totalUsers }}</h2>
                                <a href="{{ path('app_admin_user') }}" class="small text-primary text-decoration-none">Voir la liste →</a>
                            </div>
                            <div class="fs-1 text-primary opacity-50">👥</div>
                        </div>
                    </div>
                </div>

                {# Catégories #}
                <div class="col-xl-4 col-md-6">
                    <div class="card border-0 shadow-sm border-start border-4 border-success h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fw-semibold text-uppercase fs-7">Catégories</span>
                                <h2 class="fw-bold my-1 text-dark">{{ totalCategories }}</h2>
                                <a href="{{ path('app_admin_categories_dashboard') }}" class="small text-success text-decoration-none">Gérer les catégories →</a>
                            </div>
                            <div class="fs-1 text-success opacity-50">📁</div>
                        </div>
                    </div>
                </div>

                {# Produits #}
                <div class="col-xl-4 col-md-6">
                    <div class="card border-0 shadow-sm border-start border-4 border-warning h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fw-semibold text-uppercase fs-7">Produits en vente</span>
                                <h2 class="fw-bold my-1 text-dark">{{ totalProducts }}</h2>
                                <a href="{{ path('app_product_index') }}" class="small text-warning text-decoration-none">Voir l'inventaire →</a>
                            </div>
                            <div class="fs-1 text-warning opacity-50">🌿</div>
                        </div>
                    </div>
                </div>
            </div>

            {# --- SECTION 2 : ACCÈS RAPIDES AUX ACTIONS --- #}
            <h2 class="h5 fw-bold mb-3 text-secondary">Actions rapides</h2>
            
            <div class="row g-4 mb-4">
                
                {# Gestion Utilisateurs #}
                <div class="col-xl-4 col-md-6">
                    <div class="card h-100 shadow-sm border-green">
                        <div class="card-header bg-custom-green text-white fw-bold py-3">
                            👥 Gestion des Utilisateurs
                        </div>
                        <div class="card-body d-flex flex-column gap-2">
                            <a href="{{ path('app_admin_user') }}" class="btn btn-outline-dark text-start">
                                📋 Liste des membres
                            </a>
                            <a href="{{ path('app_user_new') }}" class="btn btn-sm btn-success text-start">
                                ➕ Ajouter un membre
                            </a>
                        </div>
                    </div>
                </div>

                {# Gestion Catégories #}
                <div class="col-xl-4 col-md-6">
                    <div class="card h-100 shadow-sm border-green">
                        <div class="card-header bg-custom-green text-white fw-bold py-3">
                            📁 Gestion des Catégories
                        </div>
                        <div class="card-body d-flex flex-column gap-2">
                            <a href="{{ path('app_admin_categories_dashboard') }}" class="btn btn-outline-dark text-start">
                                📋 Liste des catégories
                            </a>
                            <a href="{{ path('app_categories_new') }}" class="btn btn-sm btn-success text-start">
                                ➕ Ajouter une catégorie
                            </a>
                        </div>
                    </div>
                </div>

                {# Gestion Produits #}
                <div class="col-xl-4 col-md-6">
                    <div class="card h-100 shadow-sm border-green">
                        <div class="card-header bg-custom-green text-white fw-bold py-3">
                            🌿 Gestion des Produits
                        </div>
                        <div class="card-body d-flex flex-column gap-2">
                            <a href="{{ path('app_product_index') }}" class="btn btn-outline-dark text-start">
                                📋 Liste des produits
                            </a>
                            <a href="{{ path('app_product_new') }}" class="btn btn-sm btn-success text-start">
                                ➕ Ajouter un produit
                            </a>
                        </div> 
                    </div>
                </div>

                {# Gestion Commandes #}
                <div class="col-xl-6 col-md-6">
                    <div class="card h-100 shadow-sm border-green">
                        <div class="card-header bg-custom-green text-white py-3 fw-bold">
                            📦 Gestion des Commandes
                        </div>
                        <div class="card-body">
                            <p class="text-muted small">Consultez l'historique global des achats et l'état des livraisons.</p>
                            <a href="{{ path('app_admin_commande_dashboard') }}" class="btn btn-primary w-100">
                                Voir toutes les commandes
                            </a>
                        </div> 
                    </div>
                </div>

                {# Gestion Adresses #}
                <div class="col-xl-6 col-md-6">
                    <div class="card h-100 shadow-sm border-green">
                        <div class="card-header bg-custom-green text-white py-3 fw-bold">
                            📍 Gestion des Adresses
                        </div>
                        <div class="card-body d-flex flex-column gap-2">
                            <a href="{{ path('app_admin_adresse_de_livraison_index') }}" class="btn btn-outline-dark text-start">
                                📋 Liste des adresses de livraison
                            </a>
                            <a href="{{ path('app_adresse_de_livraison_new') }}" class="btn btn-sm btn-success text-start">
                                ➕ Créer une nouvelle adresse
                            </a>
                        </div> 
                    </div>
                </div>

            </div>
        </main>
    {% else %}
        <div class="flex-grow-1 my-5 text-center">
            <div class="alert alert-danger d-inline-block px-5 py-3 rounded-3" role="alert">
                <strong>Accès refusé :</strong> Vous devez être connecté pour accéder à cette page.
            </div>
        </div>
    {% endif %}

</div>
{% endblock %}