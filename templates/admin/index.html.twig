{% extends 'base.html.twig' %}

{% block nav %}{% endblock %}
{% block footer %}{% endblock %}

{% block title %}Back office{% endblock %}
{% block h1 %}Back office{% endblock %}

{% block body %}
{# min-vh-100 prend toute la hauteur, w-100 et vw-100 s'assurent que ça prend toute la largeur #}
<div class="d-flex flex-column flex-md-row min-vh-100 w-100 m-0 p-0">

    {# --- BLOC 1 : L'ASIDE (Reste identique, calé à gauche) --- #}
    <aside class="sidebar ">
        <div class="logo text-custom-brown text-center">
            <h2>AdminPanel</h2>
            <img src="{{ asset('images/logo_Projet.png') }}" alt="logo" style="max-width: 120px;">
        </div>
        <br><br>
        <nav class="nav-links d-grid gap-2 px-3">
            <a href="{{ path('app_home') }}" target="_blank" class="list-group-item list-group-item-action bg-custom-green-admin">
                Voir le site public
            </a>

            <hr class="text-muted my-2">

            <a href="{{ path('app_admin_user') }}" class="list-group-item list-group-item-action bg-custom-green-admin">
                Utilisateurs
            </a>
            
            <a href="{{ path('app_product_index') }}" class="list-group-item list-group-item-action bg-custom-green-admin">
                Produits
            </a>
            
            <a href="{{ path('app_admin_categories_dashboard') }}" class="list-group-item list-group-item-action bg-custom-green-admin">
               Catégories
            </a>
            
            <a href="{{ path('app_cart') }}" class="list-group-item list-group-item-action bg-custom-green-admin">
                Accès panier
            </a>
             <a href="{{ path('app_commande_creer') }}" class="list-group-item list-group-item-action bg-custom-green-admin">
                commande
            </a>
            
            <a href="{{ path('app_logout') }}" class="btn btn-danger text-start mt-3">
                Déconnexion
            </a>
        </nav>
    </aside>

   {# --- BLOC 2 : LE CONTENU PRINCIPAL (Ajusté pour s'étendre au maximum) --- #}
    {% if app.user %}
        {# On s'assure avec w-100 et px-md-5 qu'on prend tout l'espace restant de l'écran #}
        <div class="flex-grow-1 w-100 p-3 px-md-5 py-md-4">
            
            <div class="text-center mb-5">
                <h2 class="fw-bold text-custom-green-l">Tableau de bord Administration</h2>
                <p class="text-muted text-dark">Bienvenue, {{ app.user.firstname|capitalize }}.</p>
            </div>

            {# Le conteneur "row" prend désormais toute la largeur disponible de son parent #}
            <div class="row g-4 w-100 m-0">
                
                {# SECTION GESTION DES UTILISATEURS #}
                <div class="col-xl-4 col-md-6 p-0 px-md-2">
                    <div class="card h-100 shadow-sm border-green">
                        <div class="card-header bg-custom-green text-white fw-bold py-3">
                            Gestion des Utilisateurs
                            <span class="badge bg-white text-custom-brown rounded-pill">({{ totalUsers }} membres)</span>
                        </div>
                        <div class="list-group list-group-flush">
                            <a href="{{ path('app_admin_user') }}" class="list-group-item list-group-item-action">Liste des membres</a>
                            <a href="{{ path('app_user_show', {'id': app.user.id}) }}" class="list-group-item list-group-item-action">Mon profil admin</a>
                            <a href="{{ path('app_user_new') }}" class="list-group-item list-group-item-action">Ajouter un membre</a>
                            <a href="{{ path('app_user_edit', {'id': app.user.id}) }}" class="list-group-item list-group-item-action">Modifier mon profil</a>
                        </div>
                    </div>
                </div>

                {# SECTION GESTION DES CATÉGORIES #}
                <div class="col-xl-4 col-md-6 p-0 px-md-2">
                    <div class="card h-100 shadow-sm border-green">
                        <div class="card-header bg-custom-green text-white fw-bold py-3">
                            Gestion des catégories
                            <span class="badge bg-white text-custom-brown rounded-pill">({{ totalCategories }} catégories)</span>
                        </div>
                        <div class="list-group list-group-flush">
                            <a href="{{ path('app_categories') }}" class="list-group-item list-group-item-action">Liste des catégories</a>
                            <a href="{{ path('app_categories_new') }}" class="list-group-item list-group-item-action">Ajouter une catégorie</a>
                        </div>
                    </div>
                </div>

                {# SECTION GESTION DES PRODUITS #}
                <div class="col-xl-4 col-md-6 p-0 px-md-2">
                    <div class="card h-100 shadow-sm border-green">
                        <div class="card-header bg-custom-green text-white py-3">
                            🌿 Gestion des produits
                            <span class="badge bg-white text-custom-brown rounded-pill">{{ totalProducts }} produits</span>
                        </div>
                        <div class="list-group list-group-flush">
                            <a href="{{ path('app_product_index') }}" class="list-group-item list-group-item-action">Liste des produits</a>
                            <a href="{{ path('app_home_catalogue') }}" class="list-group-item list-group-item-action">Catalogue</a>
                            <a href="{{ path('app_product_new') }}" class="list-group-item list-group-item-action">Ajouter un produit</a>
                            <a href="{{ path('app_cart') }}" class="list-group-item list-group-item-action">Gestion du panier</a>
                        </div> 
                    </div>
                </div>

                 {# SECTION GESTION DES adresses de livraison #}
                <div class="col-xl-4 col-md-6 p-0 px-md-2">
                    <div class="card h-100 shadow-sm border-green">
                        <div class="card-header bg-custom-green text-white py-3">
                            🌿 Gestion des adresses
                            <span class="badge bg-white text-custom-brown rounded-pill">{{ totalProducts }} produits</span>
                        </div>
                        <div class="list-group list-group-flush">
                            <a href="{{ path('app_product_index') }}" class="list-group-item list-group-item-action">Liste des produits</a>
                            <a href="{{ path('app_home_catalogue') }}" class="list-group-item list-group-item-action">Catalogue</a>
                            <a href="{{ path('app_product_new') }}" class="list-group-item list-group-item-action">Ajouter un produit</a>
                            <a href="{{ path('app_cart') }}" class="list-group-item list-group-item-action">Gestion du panier</a>
                        </div> 
                    </div>
                </div>
                    
                {# TABLEAU DE LA LISTE DES MEMBRES INSCRITS #}
                <div class="col-12 mt-5 p-0 px-md-2">
                    <div class="card shadow-sm border-green table-card-clean">
                        <div class="card-header bg-custom-green text-white fw-bold py-3">
                           Information des membres inscrits
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-striped vertical-align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Prénom</th>
                                            <th>Nom</th>
                                            <th>Email</th>
                                            <th>Rôle</th>
                                            <th>Date d'Inscription</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for leMembre in users %}
                                            <tr>
                                                <td>{{ leMembre.id }}</td>
                                                <td>{{ leMembre.firstname|capitalize }}</td>
                                                <td>{{ leMembre.lastname|upper }}</td>
                                                <td>{{ leMembre.email }}</td>
                                                <td>
                                                    {% if 'ROLE_ADMIN' in leMembre.roles %}
                                                        <span class="badge bg-danger">Administrateur</span>
                                                    {% else %}
                                                        <span class="badge bg-custom-green">Membre</span>
                                                    {% endif %}
                                                </td>
                                                <td>{{ leMembre.createdAt|date('d/m/Y à H:i') }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div> {# Fin de la div row #}
        </div>
    {% else %}
        <div class="flex-grow-1 my-5 text-center">
            <div class="alert alert-danger d-inline-block px-5 py-3 rounded-3" role="alert">
                <strong>Accès refusé :</strong> Vous devez être connecté pour accéder à cette page.
            </div>
        </div>
    {% endif %}

</div>
{% endblock %}