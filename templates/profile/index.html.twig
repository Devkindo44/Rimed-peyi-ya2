{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Mon espace client{% endblock %}
{% block description %}{{ parent() }} | Mon espace client{% endblock %}
{% block keywords %}{{ parent() }} | Mon espace client{% endblock %}
{% block h1 %}Mon espace client{% endblock %}

{% block body %}
<div class="container mt-4 mb-5">

    {# Messages Flash #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'danger' ? 'danger' : 'success' }} alert-dismissible fade show shadow-sm" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row g-4">
    
        {# COLONNE GAUCHE : FORMULAIRE PROFIL (Infos personnelles & Sécurité) #}
        <div class="col-lg-6">
            {{ form_start(profileForm) }}
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header text-white" style="background-color: var(--main-green) !important;">
                    <h2 class="h5 mb-0 py-1">Mes informations personnelles</h2>
                </div>
                <div class="card-body bg-light">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_row(profileForm.firstName) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_row(profileForm.lastName) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_row(profileForm.email) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(profileForm.numeroDeTelephone) }}
                    </div>

                    <hr class="my-4">

                    <h3 class="h6 fw-semibold text-muted mb-3">Sécurité du compte</h3>
                    {{ form_row(profileForm.plainPassword) }}

                    <div class="mt-4 text-end">
                        <button type="submit" class="btn btn-custom-green btn-md px-4">
                            Sauvegarder mon profil
                        </button>
                    </div>
                </div>
            </div>
            {{ form_end(profileForm) }}
        </div>

        {# COLONNE DROITE : GESTION DES ADRESSES (Cartes CRUD) #}
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: var(--main-green) !important;">
                    <h2 class="h5 mb-0 py-1">Mes adresses de livraison</h2>
                    
                    {# Bouton Ajouter Une Adresse (CRUD new) #}
                    <a href="{{ path('app_adresse_de_livraison_new') }}" class="btn btn-sm btn-light fw-semibold text-success shadow-sm">
                        ➕ Ajouter
                    </a>
                </div>
                
                <div class="card-body bg-light">
                    {% for adresse in user.adresseDeLivraisons %}
                        <div class="border rounded p-3 mb-3 bg-white shadow-sm position-relative">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h3 class="h6 fw-bold m-0" style="color: var(--main-green);">
                                    Adresse #{{ loop.index }}
                                </h3>
                                
                                {# Boutons d'action CRUD (Edit / Delete) #}
                                <div class="d-flex gap-2">
                                    <a href="{{ path('app_adresse_de_livraison_edit', {'id': adresse.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                                        ✏️ Modifier
                                    </a>
                                    
                                    <form method="post" action="{{ path('app_adresse_de_livraison_delete', {'id': adresse.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette adresse ?');" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ adresse.id) }}">
                                        <button class="btn btn-sm btn-outline-danger" title="Supprimer">
                                            🗑️
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <p class="mb-1 text-dark">{{ adresse.adressePostale }}</p>
                            <p class="mb-1 text-dark">{{ adresse.codePostale }} {{ adresse.ville }}</p>
                            {% if adresse.telephone %}
                                <p class="mb-0 text-muted small">📞 {{ adresse.telephone }}</p>
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="alert alert-info mb-0 d-flex align-items-center">
                            {{ ux_icon('lucide:info', {class: 'me-2'}) }} Aucune adresse de livraison enregistrée pour le moment.
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

    </div>

    {# --- ZONE DE DANGER : SUPPRESSION DU COMPTE --- #}
    <div class="card border-danger shadow-sm mt-5">
        <div class="card-header bg-danger text-white fw-bold">
            Zone de danger
        </div>
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="card-title text-danger mb-1">Supprimer mon compte</h5>
                <p class="card-text text-muted small mb-0">Cette action est définitive et effacera l'ensemble de vos données.</p>
            </div>
            
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
                🗑️ Supprimer mon compte
            </button>
        </div>
    </div>

</div>

{# --- MODAL DE CONFIRMATION SUPPRESSION COMPTE --- #}
<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteAccountModalLabel">Confirmation de suppression</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Êtes-vous absolument sûr de vouloir supprimer votre compte ? Toutes vos adresses et informations seront supprimées définitivement.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <form action="{{ path('app_account_delete') }}" method="POST">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_account_' ~ app.user.id) }}">
                    <button type="submit" class="btn btn-danger">Oui, supprimer définitivement</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}