{% extends 'base.html.twig' %}

{% block title %}
    {{ parent() }}
    | Fiche
    {{ product.title }}
{% endblock %}
{% block h1 %}Fiche "{{ product.title }}"
{% endblock %}

{% block body %}
    <div class="container my-5 px-4">

        {# BOUTON RETOUR #}
        <div class="mb-4">
        {% if is_granted('ROLE_ADMIN') %}
            <a class="btn btn-custom-green mb-4" href="{{ path('app_product_index') }}">
                {{ ux_icon('lucide:arrow-left', {class: 'me-1 icon20'}) }}
                Gestion des produits
            </a>
        {% endif %}
        </div>

        {# CARTE PRINCIPALE PRODUIT #}
        <div class="row g-4 bg-custom-cream p-4 p-md-5 rounded-4 shadow-lg ">

            {# COLONNE GAUCHE : L'IMAGE #}
            <div class="col-md-5 col-lg-4 text-center bg-white ">
             
                <div class="d-flex  flex-column align-items-center justify-content-center card product-card  rounded-3 p-3 shadow-sm  h-100" style="min-height: 300px;">
                     <h2 class="section-title text-custom-brown mb-5  fs-1">{{ product.title }}</h2>
                
                    {% if product.illustration %}
                        <img src="{{ asset('images/' ~ product.illustration) }}" alt="{{ product.title }}" class="img-fluid rounded-3 shadow-lg mx-auto d-block my-3" style="max-height: 350px; object-fit: contain;">
                    {% else %}
                        <div class="text-muted py-5">
                            {{ ux_icon('lucide:image-off', {class: 'icon40 mb-2 text-custom-brown'}) }}
                            <p class="mb-0 small fw-medium">Aucune illustration disponible</p>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# COLONNE DROITE : LES INFORMATIONS #}
            <div class="col-md-7 col-lg-8 d-flex flex-column justify-content-between ">
                <div>
                    {# Titre & Badge ID optionnel #}
                    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2">
                        <h2 class="section-title text-custom-green-l text-center mb-2 fs-2">
                           Retrouvez vitalité & équilibre en un clic
                        </h2>

                        {% if is_granted('ROLE_ADMIN') %}
                            <span class="badge bg-custom-brown font-monospace opacity-75 py-2 px-3 rounded-pill">
                                ID: #{{ product.id }}
                            </span>
                        {% endif %}
                    </div>
                    <div class="title-underline mb-4" style="width: 60px;"></div>

                    {# Prix #}
                    <div class="mb-2">
                        <span class="fs-2 fw-bold text-custom-brown">{{ product.price }} €</span>
                    </div>

                    {# --- BLOC CONTENANCE / CONDITIONNEMENT --- #}
                    {% if product.contenance %}
                        <div class="mb-4">
                            <span class="text-muted small fw-medium">
                                {{ ux_icon('lucide:package', {class: 'me-1 icon16 text-custom-green-l', style: 'vertical-align: text-bottom;'}) }}
                                <strong>Format :</strong> {{ product.contenance }}
                            </span>
                        </div>
                    {% endif %}
                    {# ----------------------------------------- #}

                    {# Bloc Description #}
                    <div class="mb-4 ">
                        <h6 class="text-uppercase fw-bold text-muted small tracking-wider mb-2">Description / Bienfaits</h6>
                        
                        <div class="p-3 bg-white rounded-3 border-start border-success border-3 text-dark fs-6" 
                            style="line-height: 1.6; max-height: 150px; overflow-y: auto; word-break: break-word;">
                            
                            {{ product.description }}
                            Le curcuma (Curcuma longa) est une plante herbacée aux multiples vertus médicinales et culinaires, reconnue pour ses propriétés anti-inflammatoires, antioxydantes et digestives. Le curcuma (Curcuma longa) est une plante herbacée aux multiples vertus médicinales et culinaires, reconnue pour ses propriétés anti-inflammatoires, antioxydantes et digestives. Le curcuma (Curcuma longa) est une plante herbacée aux multiples vertus médicinales et culinaires, reconnue pour ses propriétés anti-inflammatoires, antioxydantes et digestives. Le curcuma (Curcuma longa) est une plante herbacée aux multiples vertus médicinales et culinaires, reconnue pour ses propriétés anti-inflammatoires, antioxydantes et digestives. 

                        </div>
                    </div>

                    {# État du Stock #}
                    <div class="mb-4 d-flex align-items-center gap-2">
                        <span class="text-uppercase fw-bold text-muted small tracking-wider me-2">Disponibilité:</span>

                        {# On vérifie d'abord si le stock existe, puis on accède à sa propriété numérique #}
                        {% if product.stock and product.stock.quantity > 0 %}
                            <span class="badge bg-custom-green px-3 py-2 rounded-pill fw-medium">
                                {{ ux_icon('lucide:check-circle', {class: 'me-1 icon20'}) }}
                                En stock ({{ product.stock.quantity }})
                            </span>
                        {% else %}
                            <span class="badge bg-danger px-3 py-2 rounded-pill fw-medium">
                                {{ ux_icon('lucide:alert-triangle', {class: 'me-1 icon20'}) }}
                                Rupture de stock
                            </span>
                        {% endif %}
                    </div>
                </div>

                {# BOUTONS D'ACTION #}
                <div class="border-top pt-4 mt-4 d-flex flex-wrap gap-2 justify-content-end">
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn btn-warning px-4 py-2 rounded-pill fw-medium">
                            {{ ux_icon('lucide:edit', {class: 'me-1 icon20'}) }}
                            Modifier ce produit
                        </a>
                    {% endif %}

                    {# Formulaire d'ajout au panier avec choix de la quantité #}
                    <form action="{{ path('app_cart_new', {'id': product.id}) }}" method="POST" class="d-flex align-items-center gap-2 m-0">
                        <div class="input-group" style="max-width: 110px;">
                            <span class="input-group-text bg-light text-dark py-2">Qté</span>
                            <input type="number" name="quantity" class="form-control text-center py-2" placeholder="Qté" min="1" max="100" value="1">
                        </div>
                        
                        <button type="submit" class="btn btn-custom-brown px-4 py-2 rounded-pill fw-medium transition-all">
                            {{ ux_icon('lucide:shopping-bag', {class: 'me-2 icon20'}) }}
                            Ajouter au panier
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
{% endblock %}