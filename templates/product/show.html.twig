{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Fiche {{ product.title }}{% endblock %}
{% block h1 %}Fiche "{{ product.title }}"{% endblock %}

{% block body %}
<div class="container mt-4">
    
    {# Bouton de retour à la liste #}
    <a class="btn btn-custom-green mb-4" href="{{ path('app_product_index') }}">
        {{ ux_icon('lucide:arrow-left', {class: 'me-1 icon20'}) }} Gestion des produits
    </a>

    <div class="row bg-light p-4 rounded border shadow-sm">
        {# Colonne Gauche : L'image du produit #}
        <div class="col-md-4 text-center mb-3 mb-md-0">
            {% if product.illustration %}
                <img src="{{ asset('images/' ~ product.illustration) }}" alt="{{ product.title }}" class="img-fluid rounded img-thumbnail shadow-sm" style="max-height: 300px; object-fit: cover;">
            {% else %}
                <div class="border rounded d-flex flex-column align-items-center justify-content-center bg-white text-muted" style="height: 250px;">
                    {{ ux_icon('lucide:image-off', {class: 'icon40 mb-2'}) }}
                    <span>Aucune illustration</span>
                </div>
            {% endif %}
        </div>

        {# Colonne Droite : Les informations détaillées #}
        <div class="col-md-8">
            <table class="table table-bordered bg-white">
                <tbody>
                    <tr>
                        <th class="table-secondary" style="width: 25%;">ID</th>
                        <td>{{ product.id }}</td>
                    </tr>
                    <tr>
                        <th class="table-secondary">Titre</th>
                        <td><strong>{{ product.title }}</strong></td>
                    </tr>
                    <tr>
                        <th class="table-secondary">Prix</th>
                        <td><span class="badge bg-success fs-6">{{ product.price }} €</span></td>
                    </tr>
                    <tr>
                        <th class="table-secondary">Description</th>
                        <td>{{ product.description|nl2br }}</td>
                    </tr>
                </tbody>
            </table>

            {# Boutons d'action en bas de fiche #}
            <div class="d-flex justify-content-end mt-3">
                <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn btn-warning me-2">
                    
                    {{ ux_icon('lucide:edit', {class: 'me-1 icon20'}) }} Modifier ce produit
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}