{% extends 'base.html.twig' %}

{% block title %}{{parent()}} | Ajouter un produit{% endblock %}
{% block description %}{{parent()}} | Ajouter un produit{% endblock %}
{% block keywords %}{{parent()}} |  Ajouter un produit{% endblock %}
{% block h1 %}Ajouter un produit{% endblock %}

{% block body %}

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div style="padding: 15px; background-color: #f8d7da; color: #721c24; margin-bottom: 20px; border: 1px solid #f5c6cb;">
            [{{ label }}] {{ message }}
        </div>
    {% endfor %}
{% endfor %}

<a class="btn btn-custom-green mb-3" href="{{path('app_product_index')}}">Gestion des produits</a>



<div class="w-75 mx-auto border-brown p-4">
    {# On ajoute novalidate pour forcer Symfony à valider et ainsi déclencher le flash danger
        L'attribut 'novalidate': 'novalidate' sert à désactiver la validation automatique du navigateur (HTML5) pour forcer l'utilisation exclusive de la validation de Symfony (Back-end).
    
     #}
    {{form_start(formProduct, {'attr': {'novalidate': 'novalidate'}})}} 

        {#  OBLIGATOIRE : Affiche les erreurs globales du formulaire (ex: CSRF ou erreurs globales) #}
       

        <div class="row mb-3">
            <div class="col">
                {{form_row(formProduct.title)}} 
            </div>
            <div class="col">
                {{form_row(formProduct.price)}} 
            </div>      
        </div>

        <div class="mb-3">
            {{form_row(formProduct.illustration)}} 
        </div>
        
        <div class="mb-3">
          
            {{form_row(formProduct.description)}} 
        </div>

        <div class="mb-3">
            {{form_row(formProduct.categories)}} 
        </div>
        <div class="mb-3">
            {{form_row(formProduct.stock)}} 
        </div>
        
        <div class="mb-3">
            {{ form_row(formProduct.contenance) }}
        </div>

        <button type="submit" class="btn btn-custom-brown w-100 mt-2">Ajouter le produit</button>

    {{form_end(formProduct)}} 
</div>
{% endblock %}