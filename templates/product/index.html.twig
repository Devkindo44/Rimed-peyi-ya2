{% extends 'base.html.twig' %}


{% block title %}{{parent()}} | Gestion des produits{% endblock %}
{% block description %}{{parent()}} | Gestion des produits{% endblock %}
{% block keywords %}{{parent()}} |  Gestion des produits{% endblock %}
{% block h1 %}Gestion des produits{% endblock %}

{% block body %}

<a class="btn btn-custom-green"href="{{path('app_product_new')}}">Gestion des produits</a>

{# <pre>
{{dump(products)}};
</pre> #}
{#si le tableau product contient quelque qqch#}

{% if products %}
    {# Tableau en html#}
    <table class="table table-striped table-bordered table-hover text-center mt-3">
        <thead class="table-success">
            <tr>
                <th>ID</th>
                <th>Titre</th>
                <th>Illustration</th>
                <th>Prix(€)</th>
                <th>Description</th>
               <th></th>
            </tr>
        </thead>
        <tbody>

        {#
            A chaque tour de boucle l'objet est injecté dans le "terme" product 

            on n'affiche pas le produit mais ce que 
        #}
            {% for product in products %}
            {# <pre>
            {{dump(products)}};
            </pre> #}
                <tr>
                    <td>{{product.id}}</td>
                    <td>{{product.title|capitalize}}</td>
                    <td>{{product.illustration}}</td>
                    <td>{{product.price}}</td>
                    <td>
                    {# condition pour afficher une icone s'il n'y apas d'image#}
                        {% if product.Description|length > 20 %}
                            {{product.Description| slice(0,17) }}...
                        {% else %}
                            {{product.Description|nl2br}}
                            {{ux_icon('lucide:circle-off',{class:'text-danger icon20'})}}
                       {% endif %}
                    </td>
                    <td>
                        {# Icône Modifier #}
                        <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="text-decoration-none">
                            {{ ux_icon('lucide:edit', {class: 'text-primary icon20'}) }}
                        </a>
                        
                        {# Icône Supprimer #}
                        <a href="#" class="text-decoration-none">
                            {{ ux_icon('lucide:trash-2', {class: 'text-danger icon20'}) }}
                        </a>  
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
   
{% else %}
    
{% endif %}

{% endblock %}
